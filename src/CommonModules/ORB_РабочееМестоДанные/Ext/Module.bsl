#Область ПубличныйИнтерфейс

Функция ПолучитьОбязательства(Организация, Направление = "") Экспорт
    Условия = "Обязательства.Организация = &Организация";
    Если Не ПустаяСтрока(Направление) Тогда
        Условия = Условия + " И Обязательства.Направление = &Направление";
    КонецЕсли;

    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   Обязательства.ObligationID,
        |   Обязательства.Направление,
        |   Обязательства.DebtorParticipantID,
        |   Обязательства.CreditorParticipantID,
        |   Обязательства.Контрагент,
        |   Обязательства.ИсходныйДокумент,
        |   Обязательства.ИсходнаяСумма,
        |   Обязательства.ТекущийОстаток,
        |   Обязательства.Валюта,
        |   Обязательства.Срок,
        |   Обязательства.OrbitasStatus,
        |   Обязательства.Обновлено
        |ИЗ
        |   РегистрСведений.ORB_ОбязательстваКэш КАК Обязательства
        |ГДЕ " + Условия + "
        |УПОРЯДОЧИТЬ ПО
        |   Обязательства.Срок,
        |   Обязательства.Контрагент");

    Запрос.УстановитьПараметр("Организация", Организация);
    Если Не ПустаяСтрока(Направление) Тогда
        Запрос.УстановитьПараметр("Направление", Направление);
    КонецЕсли;

    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьПредложения(Организация) Экспорт
    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   Предложения.ProposalID,
        |   Предложения.Сумма,
        |   Предложения.Валюта,
        |   Предложения.Состояние,
        |   Предложения.ТребуетНовогоКонтрагента,
        |   Предложения.CandidatePathJSON,
        |   Предложения.Создано,
        |   Предложения.Обновлено
        |ИЗ
        |   РегистрСведений.ORB_ПредложенияВзаимозачета КАК Предложения
        |ГДЕ
        |   Предложения.Организация = &Организация
        |УПОРЯДОЧИТЬ ПО
        |   Предложения.Создано УБЫВ");

    Запрос.УстановитьПараметр("Организация", Организация);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьРаспоряжения(Организация) Экспорт
    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   Распоряжения.SettlementInstructionID,
        |   Распоряжения.ProposalID,
        |   Распоряжения.ПлательщикParticipantID,
        |   Распоряжения.ПолучательParticipantID,
        |   Распоряжения.Сумма,
        |   Распоряжения.Валюта,
        |   Распоряжения.Срок,
        |   Распоряжения.Состояние,
        |   Распоряжения.ОтраженоВУчете,
        |   Распоряжения.ДокументОтражения,
        |   Распоряжения.Обновлено
        |ИЗ
        |   РегистрСведений.ORB_РаспоряженияНаРасчет КАК Распоряжения
        |ГДЕ
        |   Распоряжения.Организация = &Организация
        |УПОРЯДОЧИТЬ ПО
        |   Распоряжения.Срок,
        |   Распоряжения.Обновлено УБЫВ");

    Запрос.УстановитьПараметр("Организация", Организация);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

