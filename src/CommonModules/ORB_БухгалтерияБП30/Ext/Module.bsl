#Область ПубличныйИнтерфейс

Функция НормализоватьДокумент(ДокументСсылка, ParticipantОрганизации, ParticipantКонтрагента) Экспорт
    Объект = ДокументСсылка.ПолучитьОбъект();
    ИмяМетаданных = Объект.Метаданные().Имя;

    Если ИмяМетаданных = "РеализацияТоваровУслуг" Тогда
        Debtor = ParticipantКонтрагента;
        Creditor = ParticipantОрганизации;
    ИначеЕсли ИмяМетаданных = "ПоступлениеТоваровУслуг" Тогда
        Debtor = ParticipantОрганизации;
        Creditor = ParticipantКонтрагента;
    Иначе
        ВызватьИсключение "Orbitas: документ не поддерживается reference-адаптером БП 3.0: " + ИмяМетаданных;
    КонецЕсли;

    СуммаДокумента = ЗначениеРеквизита(Объект, "СуммаДокумента", 0);
    ВалютаДокумента = ЗначениеРеквизита(Объект, "ВалютаДокумента", Неопределено);
    Если ВалютаДокумента = Неопределено Тогда
        ВалютаДокумента = ЗначениеРеквизита(Объект, "Валюта", Неопределено);
    КонецЕсли;

    КодВалюты = КодВалютыISO(ВалютаДокумента);
    Срок = ОпределитьСрок(Объект);

    Результат = Новый Структура;
    Результат.Вставить("source_system", ORB_Константы.ИсточникДанных());
    Результат.Вставить("source_ref", Строка(ДокументСсылка.УникальныйИдентификатор()));
    Результат.Вставить("source_document_type", ИмяМетаданных);
    Результат.Вставить("organization_ref", Строка(Объект.Организация.УникальныйИдентификатор()));
    Результат.Вставить("debtor_participant_id", Debtor);
    Результат.Вставить("creditor_participant_id", Creditor);
    Результат.Вставить("amount", ORB_Сериализация.СуммаСтрокой(СуммаДокумента));
    Результат.Вставить("currency", КодВалюты);
    Результат.Вставить("due_date", ORB_Сериализация.ДатаISO(Срок));
    Результат.Вставить("external_number", Строка(Объект.Номер));
    Результат.Вставить("external_date", ORB_Сериализация.ДатаISO(Объект.Дата));

    Возврат Результат;
КонецФункции

Функция ИдемпотентныйКлюч(ДокументСсылка, ОрганизацияСсылка) Экспорт
    Возврат СтрШаблон(
        "1c:%1:%2:obligation:v1",
        Строка(ОрганизацияСсылка.УникальныйИдентификатор()),
        Строка(ДокументСсылка.УникальныйИдентификатор())
    );
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеРеквизита(Объект, Имя, ПоУмолчанию)
    Если Объект.Метаданные().Реквизиты.Найти(Имя) = Неопределено Тогда
        Возврат ПоУмолчанию;
    КонецЕсли;
    Возврат Объект[Имя];
КонецФункции

Функция ОпределитьСрок(Объект)
    Для Каждого Имя Из Новый Массив("СрокОплаты", "ДатаОплаты", "ДатаПлатежа") Цикл
        Значение = ЗначениеРеквизита(Объект, Имя, Неопределено);
        Если Значение <> Неопределено И ТипЗнч(Значение) = Тип("Дата") Тогда
            Возврат Значение;
        КонецЕсли;
    КонецЦикла;
    Возврат Объект.Дата;
КонецФункции

Функция КодВалютыISO(Валюта)
    Если Валюта = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Попытка
        Возврат Валюта.Код;
    Исключение
        Возврат Строка(Валюта);
    КонецПопытки;
КонецФункции

#КонецОбласти
