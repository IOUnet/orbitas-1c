#Область ПубличныйИнтерфейс

Функция ВJSON(Значение) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(СтрокаJSON) Экспорт
    Если ПустаяСтрока(СтрокаJSON) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция ДатаISO(ДатаЗначение) Экспорт
    Если ДатаЗначение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Формат(ДатаЗначение, "ДФ=yyyy-MM-dd");
КонецФункции

Функция СуммаСтрокой(Сумма) Экспорт
    // JSON decimal передаём строкой, чтобы не терять точность.
    Возврат СтрЗаменить(Формат(Сумма, "ЧГ=0; ЧРД=.; ЧН=0.00"), " ", "");
КонецФункции

#КонецОбласти
