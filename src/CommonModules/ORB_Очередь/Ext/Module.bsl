#Область ПубличныйИнтерфейс

Функция Поставить(Организация, ТипОперации, ИдемпотентныйКлюч, ТелоJSON) Экспорт
    // Вызов выполняется локально и не делает HTTP.
    // В production добавить уникальный контроль по ИдемпотентныйКлюч.
    Идентификатор = Новый УникальныйИдентификатор;

    Набор = РегистрыСведений.ORB_ОчередьИсходящих.СоздатьНаборЗаписей();
    Запись = Набор.Добавить();
    Запись.ИдентификаторСообщения = Идентификатор;
    Запись.Организация = Организация;
    Запись.ТипОперации = ТипОперации;
    Запись.ИдемпотентныйКлюч = ИдемпотентныйКлюч;
    Запись.ТелоJSON = ТелоJSON;
    Запись.Состояние = "new";
    Запись.Попыток = 0;
    Запись.СледующаяПопытка = ТекущаяДата();
    Запись.ДатаСоздания = ТекущаяДата();
    Набор.Записать();

    Возврат Идентификатор;
КонецФункции

Процедура ОбработатьПакет(Максимум = 50) Экспорт
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ &Максимум
        |   Очередь.ИдентификаторСообщения,
        |   Очередь.Организация,
        |   Очередь.ТипОперации,
        |   Очередь.ИдемпотентныйКлюч,
        |   Очередь.ТелоJSON,
        |   Очередь.Попыток
        |ИЗ
        |   РегистрСведений.ORB_ОчередьИсходящих КАК Очередь
        |ГДЕ
        |   Очередь.Состояние В (""new"", ""error"")
        |   И Очередь.СледующаяПопытка <= &Сейчас
        |УПОРЯДОЧИТЬ ПО
        |   Очередь.ДатаСоздания");

    Запрос.УстановитьПараметр("Максимум", Максимум);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ОбработатьОдноСообщение(Выборка);
    КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьОдноСообщение(Сообщение)
    Настройки = ORB_Интеграция.ПолучитьНастройки(Сообщение.Организация);

    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Idempotency-Key", Сообщение.ИдемпотентныйКлюч);

    Попытка
        Если Сообщение.ТипОперации = "create_obligation" Тогда
            Тело = ORB_Сериализация.ИзJSON(Сообщение.ТелоJSON);
            Ответ = ORB_HTTP.ВыполнитьJSON("POST", "/v1/obligations", Тело, Настройки, Заголовки);
            ОбработатьОтветСозданияОбязательства(Сообщение, Ответ);
        Иначе
            ВызватьИсключение "Orbitas: неизвестный тип сообщения " + Сообщение.ТипОперации;
        КонецЕсли;

        УстановитьСостояние(Сообщение.ИдентификаторСообщения, "done", "", Сообщение.Попыток + 1);
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        НовоеЧислоПопыток = Сообщение.Попыток + 1;
        НовоеСостояние = ?(НовоеЧислоПопыток >= 10, "dead", "error");
        УстановитьСостояние(Сообщение.ИдентификаторСообщения, НовоеСостояние, ТекстОшибки, НовоеЧислоПопыток);
    КонецПопытки;
КонецПроцедуры

