#Область ПубличныйИнтерфейс

Функция Поставить(Организация, ИсходныйДокумент, ТипОперации, ИдемпотентныйКлюч, ТелоJSON) Экспорт
    Существующее = НайтиПоИдемпотентномуКлючу(Организация, ИдемпотентныйКлюч);
    Если Существующее <> Неопределено Тогда
        Возврат Существующее;
    КонецЕсли;

    Идентификатор = Новый УникальныйИдентификатор;

    Набор = РегистрыСведений.ORB_ОчередьИсходящих.СоздатьНаборЗаписей();
    Запись = Набор.Добавить();
    Запись.ИдентификаторСообщения = Идентификатор;
    Запись.Организация = Организация;
    Запись.ИсходныйДокумент = ИсходныйДокумент;
    Запись.ТипОперации = ТипОперации;
    Запись.ИдемпотентныйКлюч = ИдемпотентныйКлюч;
    Запись.ТелоJSON = ТелоJSON;
    Запись.Состояние = "new";
    Запись.Попыток = 0;
    Запись.СледующаяПопытка = ТекущаяДата();
    Запись.ДатаСоздания = ТекущаяДата();
    Набор.Записать();

    Возврат Идентификатор;
КонецФункции

Процедура ОбработатьПакет(Максимум = 50) Экспорт
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ &Максимум
        |   Очередь.ИдентификаторСообщения,
        |   Очередь.Организация,
        |   Очередь.ИсходныйДокумент,
        |   Очередь.ТипОперации,
        |   Очередь.ИдемпотентныйКлюч,
        |   Очередь.ТелоJSON,
        |   Очередь.Попыток
        |ИЗ
        |   РегистрСведений.ORB_ОчередьИсходящих КАК Очередь
        |ГДЕ
        |   Очередь.Состояние В (""new"", ""error"")
        |   И Очередь.СледующаяПопытка <= &Сейчас
        |УПОРЯДОЧИТЬ ПО
        |   Очередь.ДатаСоздания");

    Запрос.УстановитьПараметр("Максимум", Максимум);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ОбработатьОдноСообщение(Выборка);
    КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПоИдемпотентномуКлючу(Организация, Ключ)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   Очередь.ИдентификаторСообщения
        |ИЗ
        |   РегистрСведений.ORB_ОчередьИсходящих КАК Очередь
        |ГДЕ
        |   Очередь.Организация = &Организация
        |   И Очередь.ИдемпотентныйКлюч = &Ключ");

    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("Ключ", Ключ);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.ИдентификаторСообщения;
    КонецЕсли;

    Возврат Неопределено;
КонецФункции

Процедура ОбработатьОдноСообщение(Сообщение)
    Настройки = ORB_Интеграция.ПолучитьНастройки(Сообщение.Организация);

    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Idempotency-Key", Сообщение.ИдемпотентныйКлюч);

    Попытка
        Если Сообщение.ТипОперации = "create_obligation" Тогда
            Тело = ORB_Сериализация.ИзJSON(Сообщение.ТелоJSON);
            Ответ = ORB_HTTP.ВыполнитьJSON("POST", "/v1/obligations", Тело, Настройки, Заголовки);
            ОбработатьОтветСозданияОбязательства(Сообщение, Ответ);
        Иначе
            ВызватьИсключение "Orbitas: неизвестный тип сообщения " + Сообщение.ТипОперации;
        КонецЕсли;

        УстановитьСостояние(Сообщение.ИдентификаторСообщения, "done", "", Сообщение.Попыток + 1);
    Исключение
        ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        НовоеЧислоПопыток = Сообщение.Попыток + 1;
        НовоеСостояние = ?(НовоеЧислоПопыток >= 10, "dead", "error");
        УстановитьСостояние(
            Сообщение.ИдентификаторСообщения,
            НовоеСостояние,
            ТекстОшибки,
            НовоеЧислоПопыток
        );
    КонецПопытки;
КонецПроцедуры

Процедура ОбработатьОтветСозданияОбязательства(Сообщение, Ответ)
    Если Ответ = Неопределено Тогда
        ВызватьИсключение "Orbitas: пустой ответ при создании обязательства.";
    КонецЕсли;

    ObligationID = "";
    Status = "created";
    Amount = 0;
    Remaining = 0;
    Currency = "";

    Если Ответ.Свойство("obligation_id") Тогда ObligationID = Ответ.obligation_id; КонецЕсли;
    Если Ответ.Свойство("status") Тогда Status = Ответ.status; КонецЕсли;
    Если Ответ.Свойство("amount") Тогда Amount = Число(Ответ.amount); КонецЕсли;
    Если Ответ.Свойство("remaining_amount") Тогда Remaining = Число(Ответ.remaining_amount); КонецЕсли;
    Если Ответ.Свойство("currency") Тогда Currency = Ответ.currency; КонецЕсли;

    Если ПустаяСтрока(ObligationID) Тогда
        ВызватьИсключение "Orbitas: ответ не содержит obligation_id.";
    КонецЕсли;

    Набор = РегистрыСведений.ORB_СвязиОбязательств.СоздатьНаборЗаписей();
    Набор.Отбор.Организация.Установить(Сообщение.Организация);
    Набор.Отбор.ИсходныйДокумент.Установить(Сообщение.ИсходныйДокумент);
    Набор.Прочитать();
    Набор.Очистить();

    Запись = Набор.Добавить();
    Запись.Организация = Сообщение.Организация;
    Запись.ИсходныйДокумент = Сообщение.ИсходныйДокумент;
    Запись.ObligationID = ObligationID;
    Запись.OrbitasStatus = Status;
    Запись.ИсходнаяСумма = Amount;
    Запись.ТекущийОстаток = Remaining;
    Запись.Валюта = Currency;
    Запись.ДатаОбновления = ТекущаяДата();
    Набор.Записать();
КонецПроцедуры

Процедура УстановитьСостояние(Идентификатор, Состояние, Ошибка, Попыток)
    Набор = РегистрыСведений.ORB_ОчередьИсходящих.СоздатьНаборЗаписей();
    Набор.Отбор.ИдентификаторСообщения.Установить(Идентификатор);
    Набор.Прочитать();

    Для Каждого Запись Из Набор Цикл
        Запись.Состояние = Состояние;
        Запись.Попыток = Попыток;
        Запись.ПоследняяОшибка = Ошибка;

        Если Состояние = "error" Тогда
            ЗадержкаСекунд = Мин(3600, 30 * Степень(2, Мин(Попыток, 7)));
            Запись.СледующаяПопытка = ТекущаяДата() + ЗадержкаСекунд;
        Иначе
            Запись.СледующаяПопытка = ТекущаяДата();
        КонецЕсли;
    КонецЦикла;

    Набор.Записать();
КонецПроцедуры

#КонецОбласти
