#Область ПубличныйИнтерфейс

Функция СоздатьИлиПривязатьПаспорт(Организация, ПараметрыКомпании) Экспорт
    Настройки = ПолучитьНастройкиБезПроверки(Организация);
    Если Настройки = Неопределено Тогда
        ВызватьИсключение "Orbitas: сначала укажите адрес сервера и параметры подключения.";
    КонецЕсли;

    Тело = Новый Структура;
    Тело.Вставить("source_system", ORB_Константы.ИсточникДанных());
    Тело.Вставить("organization_ref", Строка(Организация.УникальныйИдентификатор()));
    Тело.Вставить("company", ПараметрыКомпании);

    Возврат ORB_HTTP.ВыполнитьJSON("POST", "/v1/participants/passports", Тело, Настройки);
КонецФункции

Функция СоздатьОбязательство(Организация, ДокументСсылка) Экспорт
    Настройки = ПолучитьНастройки(Организация);
    ParticipantКонтрагента = ПолучитьParticipantКонтрагента(Организация, ДокументСсылка);

    DTO = ORB_БухгалтерияБП30.НормализоватьДокумент(
        ДокументСсылка,
        Настройки.ParticipantPassportID,
        ParticipantКонтрагента
    );

    Ключ = ORB_БухгалтерияБП30.ИдемпотентныйКлюч(ДокументСсылка, Организация);
    ORB_Очередь.Поставить(
        Организация,
        ДокументСсылка,
        "create_obligation",
        Ключ,
        ORB_Сериализация.ВJSON(DTO)
    );

    Возврат Ключ;
КонецФункции

Функция НайтиКандидатовВзаимозачета(Организация, ПараметрыПоиска = Неопределено) Экспорт
    Настройки = ПолучитьНастройки(Организация);

    Тело = Новый Структура("participant_id", Настройки.ParticipantPassportID);
    Если ПараметрыПоиска <> Неопределено Тогда
        Тело.Вставить("constraints", ПараметрыПоиска);
    КонецЕсли;

    Возврат ORB_HTTP.ВыполнитьJSON("POST", "/v1/clearing/candidates", Тело, Настройки);
КонецФункции

Функция СогласоватьПредложение(Организация, ProposalID) Экспорт
    Настройки = ПолучитьНастройки(Организация);
    Тело = Новый Структура("participant_id", Настройки.ParticipantPassportID);

    Возврат ORB_HTTP.ВыполнитьJSON(
        "POST",
        "/v1/clearing/proposals/" + ProposalID + "/approve",
        Тело,
        Настройки
    );
КонецФункции

Функция ОтклонитьПредложение(Организация, ProposalID, Причина = "") Экспорт
    Настройки = ПолучитьНастройки(Организация);
    Тело = Новый Структура("participant_id,reason", Настройки.ParticipantPassportID, Причина);

    Возврат ORB_HTTP.ВыполнитьJSON(
        "POST",
        "/v1/clearing/proposals/" + ProposalID + "/reject",
        Тело,
        Настройки
    );
КонецФункции

Функция ПолучитьНастройки(Организация) Экспорт
    Настройки = ПолучитьНастройкиБезПроверки(Организация);
    ПроверитьНастройки(Настройки);
    Возврат Настройки;
КонецФункции

Функция ПолучитьНастройкиБезПроверки(Организация) Экспорт
    Выборка = РегистрыСведений.ORB_НастройкиОрганизаций.СрезПоследних(
        ТекущаяДата(),
        Новый Структура("Организация", Организация)
    ).Выбрать();

    Если Не Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Настройки = Новый Структура;
    Настройки.Вставить("ParticipantPassportID", Выборка.ParticipantPassportID);
    Настройки.Вставить("БазовыйURL", Выборка.БазовыйURL);
    Настройки.Вставить("ИдентификаторПодключения", Выборка.ИдентификаторПодключения);

    Токен = "";
    Если Выборка.СекретДоступа <> Неопределено Тогда
        Попытка
            Токен = Выборка.СекретДоступа.Получить();
        Исключение
            Токен = "";
        КонецПопытки;
    КонецЕсли;
    Настройки.Вставить("ТокенДоступа", Токен);

    Возврат Настройки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНастройки(Настройки)
    Если Настройки = Неопределено Тогда
        ВызватьИсключение "Orbitas: организация не подключена.";
    КонецЕсли;
    Если ПустаяСтрока(Настройки.ParticipantPassportID) Тогда
        ВызватьИсключение "Orbitas: не привязан Participant Passport.";
    КонецЕсли;
    Если ПустаяСтрока(Настройки.БазовыйURL) Тогда
        ВызватьИсключение "Orbitas: не задан адрес сервера.";
    КонецЕсли;
КонецПроцедуры

Функция ПолучитьParticipantКонтрагента(Организация, ДокументСсылка)
    Объект = ДокументСсылка.ПолучитьОбъект();
    Контрагент = Объект.Контрагент;

    Выборка = РегистрыСведений.ORB_СопоставленияКонтрагентов.СрезПоследних(
        ТекущаяДата(),
        Новый Структура("Организация,Контрагент", Организация, Контрагент)
    ).Выбрать();

    Если Не Выборка.Следующий() Или ПустаяСтрока(Выборка.ParticipantPassportID) Тогда
        ВызватьИсключение "Orbitas: для контрагента не задан Participant Passport: " + Строка(Контрагент);
    КонецЕсли;

    Возврат Выборка.ParticipantPassportID;
КонецФункции

#КонецОбласти
