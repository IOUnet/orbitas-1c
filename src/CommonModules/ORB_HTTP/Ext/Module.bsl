#Область ПубличныйИнтерфейс

Функция ВыполнитьJSON(Метод, Путь, Тело, Настройки, ДопЗаголовки = Неопределено) Экспорт
    БазовыйURL = Настройки.БазовыйURL;
    Если ПустаяСтрока(БазовыйURL) Тогда
        ВызватьИсключение "Orbitas: не задан адрес сервера.";
    КонецЕсли;

    URL = Новый URI(БазовыйURL);
    Соединение = Новый HTTPСоединение(
        URL.Хост,
        URL.Порт,
        ,
        ,
        ,
        30,
        Новый ЗащищенноеСоединениеOpenSSL()
    );

    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Accept", "application/json");
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("X-Orbitas-Protocol", ORB_Константы.ВерсияПротокола());

    Если Настройки.Свойство("ТокенДоступа") И Не ПустаяСтрока(Настройки.ТокенДоступа) Тогда
        Заголовки.Вставить("Authorization", "Bearer " + Настройки.ТокенДоступа);
    КонецЕсли;

    Если ДопЗаголовки <> Неопределено Тогда
        Для Каждого Пара Из ДопЗаголовки Цикл
            Заголовки.Вставить(Пара.Ключ, Пара.Значение);
        КонецЦикла;
    КонецЕсли;

    Запрос = Новый HTTPЗапрос(Путь, Заголовки);
    Если Тело <> Неопределено Тогда
        Запрос.УстановитьТелоИзСтроки(ORB_Сериализация.ВJSON(Тело), КодировкаТекста.UTF8);
    КонецЕсли;

    Если ВРег(Метод) = "GET" Тогда
        Ответ = Соединение.Получить(Запрос);
    ИначеЕсли ВРег(Метод) = "POST" Тогда
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    ИначеЕсли ВРег(Метод) = "PUT" Тогда
        Ответ = Соединение.Записать(Запрос);
    Иначе
        ВызватьИсключение "Orbitas: неподдерживаемый HTTP-метод " + Метод;
    КонецЕсли;

    Код = Ответ.КодСостояния;
    Текст = Ответ.ПолучитьТелоКакСтроку();

    Если Код < 200 Или Код >= 300 Тогда
        ВызватьИсключение СтрШаблон("Orbitas HTTP %1: %2", Код, Текст);
    КонецЕсли;

    Если ПустаяСтрока(Текст) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат ORB_Сериализация.ИзJSON(Текст);
КонецФункции

#КонецОбласти
